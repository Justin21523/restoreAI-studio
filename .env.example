# RestorAI Studio canonical configuration
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
# Every inference weight is resolved below this absolute directory.
MODEL_ROOT=/mnt/c/ai_models
MODEL_AUTO_DOWNLOAD=false
DEVICE=auto
USE_FP16=true
TILE_SIZE=512

# Runtime data is deliberately separate from MODEL_ROOT.
STORAGE_ROOT=./data/storage
ARTIFACT_RETENTION_HOURS=24
DATABASE_URL=postgresql+psycopg://restorai:restorai@127.0.0.1:55432/restorai
REDIS_URL=redis://127.0.0.1:56379/0
QUEUE_NAME=restorai-gpu
QUEUE_ENABLED=true

MAX_IMAGE_BYTES=26214400
MAX_IMAGE_PIXELS=16000000
MAX_OUTPUT_PIXELS=150000000
MAX_VIDEO_BYTES=2147483648
MAX_VIDEO_DURATION_SECONDS=600
MAX_VIDEO_WIDTH=3840
MAX_VIDEO_HEIGHT=2160
MAX_VIDEO_FPS=120
MAX_IMAGE_BATCH=50
MAX_VIDEO_BATCH=10

# Ensure libraries never download weights behind the registry.
TRANSFORMERS_OFFLINE=1
HF_HUB_OFFLINE=1
